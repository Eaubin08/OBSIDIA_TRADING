# OBSIDIA_TRADING — Configuration
# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.
# Paper trading uniquement pour l'instant (ALPACA_MODE=paper) — aucun ordre live.

# Alpaca (source: agent-trad-main PASS3)
ALPACA_MODE=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_TRADING_BASE_URL=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_CRYPTO_LOCATION=us
ALPACA_TIMEOUT_S=10.0

# Paramètres de trading (référence, à ajuster par le domaine)
TRADING_SYMBOL=BTCUSDT
POSITION_SIZE_PCT=0.03
INITIAL_CAPITAL=10000.0

# Signal structurel local (NON AUTORITAIRE — voir docs/B15_STRUCTURAL_SCORE_BOUNDARY.md)
# Ce seuil ne decide jamais : c'est un signal d'entree soumis a la gouvernance KX108 reelle.
GUARD_BASE_THRESHOLD=0.18
GUARD_THETA_S=0.20
GUARD_MIN_WAIT_S=108.0
